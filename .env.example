# Generate a salted passcode hash with: node scripts/hash-admin-passcode.mjs
ADMIN_PASSCODE_HASH=scrypt$<salt-hex>$<hash-hex>

# Set a private random secret of at least 32 characters. Never expose it with NEXT_PUBLIC_.
JWT_SECRET=<private-random-secret-at-least-32-characters>

# Comma-separated production origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000

# Configure the database connection for your deployment.
MONGODB_URI=
